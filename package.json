{
  "name": "ohtms",
  "version": "0.1.0",
  "private": true,
  "description": "MAMS Hospital — Overhead Tank Management System (standalone)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "vercel-build": "npm run db:migrate && npm run db:bootstrap && next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "setup": "npm run db:migrate && npm run db:bootstrap",
    "auth:reset": "tsx scripts/reset-admin.ts",
    "backup:db": "tsx scripts/backup-db.ts",
    "restore:db": "tsx scripts/restore-db.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.66.0",
    "next": "^15.5.28",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
