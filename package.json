    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
