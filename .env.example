# ── Runtime ───────────────────────────────────────────────
# anchored = "now" is the last reading in the dataset (static snapshot, honest freshness)
# live     = "now" is the real wall clock (use once the TTS webhook is feeding data)
CLOCK_MODE=anchored
DB_PATH=./var/ohtms.db

# ── Auth ──────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-64-hex-chars-change-me-to-64-hex-chars-0000
SESSION_HOURS=8
ADMIN_EMAIL=admin@mams.local
ADMIN_PASSWORD=ChangeMe!2026

# ── Live ingest (Phase 2, optional) ───────────────────────
# Shared secret The Things Stack sends in the X-Downlink-Apikey / custom header
TTS_WEBHOOK_SECRET=
# ── Notifications (Phase 2, optional) ─────────────────────
SMTP_URL=

# ── Team workflow ─────────────────────────────────────────
# 1 = endpoints that aren't built yet return contract-valid sample data (header x-mock: 1). Dev only — keep 0 in production.
ENABLE_MOCKS=1
