# Secrets (generate with `openssl rand -hex 32`)
CRON_SECRET=
SESSION_SECRET=

# Live data ingest (POST /api/ingest). Generate with `npm run ingest:key`, then give the same value to the
# system that pushes your tank data. Comma-separate two keys to rotate without downtime. Min 32 chars.
INGEST_API_KEY=

# Database (Neon / Vercel Postgres / Supabase; pooled URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ohtms
DATABASE_URL_UNPOOLED=   # optional, direct URL used only by migrations

# App
ADMIN_EMAIL=admin@mams.local
ADMIN_PASSWORD=ChangeMe!2026
SMTP_URL=                # optional; e.g. smtp://user:pass@smtp.example.com:587
EMAIL_FROM=alerts@mams.local
